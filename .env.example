# COPY TO .env AND REPLACE EVERY SECRET BEFORE PUBLIC DEPLOYMENT
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_64_CHARACTER_SECRET
DEVICE_FRIDGE_A_SECRET=REPLACE_WITH_RANDOM_DEVICE_A_SECRET_32_BYTES
DEVICE_FRIDGE_B_SECRET=REPLACE_WITH_RANDOM_DEVICE_B_SECRET_32_BYTES
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PHARMACIST_PASSWORD=CHANGE_ME_PHARMACIST_PASSWORD
INSPECTOR_PASSWORD=CHANGE_ME_INSPECTOR_PASSWORD
DB_PATH=./coldchain.db
DEMO_MODE=1
MQTT_ENABLED=0
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Email OR Telegram; none is configured by default. Do not claim delivery without setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Optional override: leave blank for automatic localhost + actual running port.
PUBLIC_BASE_URL=
