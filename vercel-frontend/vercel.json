{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-ME.onrender.com/api/:path*"
    },
    {
      "source": "/check/:token",
      "destination": "https://REPLACE-ME.onrender.com/check/:token"
    },
    {
      "source": "/health",
      "destination": "https://REPLACE-ME.onrender.com/health"
    }
  ]
}
