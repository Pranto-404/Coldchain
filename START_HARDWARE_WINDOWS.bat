@echo off
setlocal EnableExtensions
cd /d "%~dp0"
title ColdChain - REAL ESP32 Integration (Local LAN)
echo ========================================================
echo     COLDCHAIN ON-SITE HARDWARE MODE
 echo ========================================================
echo.
echo Requires two flashed ESP32 boards, a trusted-LAN MQTT broker,
echo and private settings generated by PREPARE_HARDWARE_WINDOWS.bat.
echo NEVER attach hobby relays to 230V mains/refrigerator compressors.
echo.
if not exist ".env" (
  echo [ERROR] Missing private configuration .env.
  echo Run PREPARE_HARDWARE_WINDOWS.bat first.
  pause
  exit /b 1
)
where powershell.exe >nul 2>&1
if errorlevel 1 (
  echo [ERROR] Windows PowerShell required.
  pause
  exit /b 1
)
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0BOOTSTRAP_WINDOWS.ps1" -HardwareMode
set "rc=%errorlevel%"
if not "%rc%"=="0" echo [ERROR] Hardware-mode startup failed; check the details above.
echo Press any key to exit.
pause >nul
exit /b %rc%
